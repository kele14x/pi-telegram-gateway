# Template for a rootless Podman Compose autostart unit.
# Render it with the paths for this checkout; see README "Podman autostart".
#
# The unit runs `podman-compose up` in the foreground. Do not replace that with
# `up -d` + `podman wait`: systemd's cgroup cleanup can terminate the detached
# container when the service's launcher exits.
[Unit]
Description=pi Telegram gateway (Podman Compose)
Documentation=file://@PROJECT_DIR@/README.md
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=PATH=@COMPOSE_DIR@:/usr/local/bin:/usr/bin:/bin
ExecStart=@COMPOSE_BIN@ --in-pod=false -p pi-telegram-gateway -f docker-compose.yml -f compose.podman.yaml up gateway
ExecStop=@COMPOSE_BIN@ --in-pod=false -p pi-telegram-gateway -f docker-compose.yml -f compose.podman.yaml down
Restart=always
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=default.target
