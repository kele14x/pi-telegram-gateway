{
  "name": "pi-telegram-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Talk to a pi coding agent from Telegram (chat gateway)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.ts",
    "start:daemon": "node scripts/linux-service.mjs start:daemon",
    "autostart:setup": "node scripts/linux-service.mjs autostart:setup",
    "autostart:remove": "node scripts/linux-service.mjs autostart:remove",
    "stop": "node scripts/linux-service.mjs stop",
    "selftest": "node --env-file-if-exists=.env index.ts --selftest",
    "test": "node test/stream-test.mjs && node test/cd-test.mjs && node test/chat-meta-test.mjs && node test/settings-test.mjs && node test/lock-test.mjs && node test/residual-test.mjs && node test/shutdown-test.mjs && node test/rotation-test.mjs && node test/service-test.mjs",
    "status": "node scripts/linux-service.mjs status",
    "help": "node scripts/help.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "https-proxy-agent": "^9.1.0",
    "marked": "18.0.11",
    "proper-lockfile": "^4.1.2",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3"
  }
}
