# ── pi ↔ Telegram chat gateway ─────────────────────────────────────────────
# Copy to `.env` and fill in. The gateway reads this file at startup.

# REQUIRED: your Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# RECOMMENDED: comma-separated Telegram user/chat ids allowed to talk to the
# agent. Until set, the bot blocks everyone (and tells you your own id).
# Send /start to your bot once; the gateway logs your numeric id if you're
# not yet allowed. Example: ALLOWED_TELEGRAM_IDS=123456789,987654321
ALLOWED_TELEGRAM_IDS=

# Optional: default working folder for the agent (files, shell, ...).
# Each chat can override its own folder at runtime with /cd <path>.
# Default: the directory you launch the gateway from.
# PI_TELEGRAM_CWD=C:/Users/Kele

# Optional: directory where per-chat conversation history is persisted.
# Each Telegram chat gets its own session file, so history survives restarts.
# Default: ./sessions (next to this file)
# PI_TELEGRAM_SESSIONS_DIR=C:/Users/Kele/pi-telegram-gateway/sessions

# Optional: HTTP(S) proxy for Telegram API calls. Also honors HTTPS_PROXY/HTTP_PROXY.
# Needed if api.telegram.org is blocked/unreachable from your network.
# TELEGRAM_PROXY=http://127.0.0.1:7890

# Optional: force IPv4-only networking (IPv4-first DNS + IPv4-only Telegram
# agent). Needed only on networks where broken IPv6 makes Telegram calls stall
# (node-fetch v2 has no happy-eyeballs). Leave unset for normal dual-stack.
# PI_TELEGRAM_IPV4_ONLY=true

# Optional: model to use, same syntax as pi's --model flag, e.g.
#   anthropic/claude-opus-4-5:high
#   openai/gpt-5
#   gemini/gemini-2.5-pro:medium
# Leave empty to use pi's default model from your settings (or first available).
# PI_TELEGRAM_MODEL=

# Optional: initial thinking level: off, minimal, low, medium, high, xhigh, max
# PI_TELEGRAM_THINKING=off

# Optional: extra instructions appended to the agent's system prompt.
# PI_TELEGRAM_APPEND_PROMPT=Be extra terse. Answer in Chinese.